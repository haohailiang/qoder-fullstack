# ============================================================
# 本地环境变量模板（复制为 .env 后填写；.env 不入库，请勿提交真实密钥）
#   cp .env.example .env
# docker compose 会自动读取根目录 .env 并注入到 ecommerce-order 容器
# ============================================================

# ---------- 支付宝沙箱支付（ecommerce-order） ----------
# 沙箱控制台获取 APPID
ALIPAY_APP_ID=
# 应用私钥（PKCS8）。支持单行 Base64、含字面量 \n，或带 PEM 头尾
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（沙箱控制台「支付宝公钥」，注意不是应用公钥）
ALIPAY_PUBLIC_KEY=
# 网关地址，留空使用沙箱默认网关
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 异步通知地址：必须是支付宝服务器可达的公网地址，留空则仅依赖结果页主动查询
# 内网穿透示例：https://<隧道域名>/api/order/payments/alipay/notify
ALIPAY_NOTIFY_URL=
# 同步回跳地址（本站支付结果页）
ALIPAY_RETURN_URL=http://localhost:5173/order/pay-result
# 签名算法与超时时间
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_TIMEOUT_EXPRESS=30m