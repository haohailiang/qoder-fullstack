# ============================================================
# 本地环境变量模板（复制为 .env 后填写；.env 不入库，请勿提交真实密钥）
#   cp .env.example .env
# docker compose 会自动读取根目录 .env 并注入到 ecommerce-order 容器
# ============================================================

# ---------- 支付宝沙箱支付（ecommerce-order） ----------
# 沙箱控制台获取 APPID
ALIPAY_APP_ID=
# 应用私钥（PKCS8）。支持单行 Base64、含字面量 \n，或带 PEM 头尾
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（沙箱控制台「支付宝公钥」，注意不是应用公钥）
ALIPAY_PUBLIC_KEY=
# 网关地址，留空使用沙箱默认网关
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 异步通知地址：必须是支付宝服务器可达的公网地址，留空则仅依赖结果页主动查询
# 内网穿透示例：https://<隧道域名>/api/order/payments/alipay/notify
ALIPAY_NOTIFY_URL=
# 同步回跳地址（本站支付结果页）
ALIPAY_RETURN_URL=http://localhost:5173/order/pay-result
# 签名算法与超时时间
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_TIMEOUT_EXPRESS=30m

# ---------- 保险咨询机器人（ai-service，Python） ----------
# 智谱 GLM（OpenAI 兼容协议）：https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3

# MinerU 精准解析 API Token（仅本地填写，禁止提交）
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
# pipeline / vlm
MINERU_MODEL_VERSION=pipeline
# MinerU 不可用时是否降级为本地 pypdf 提取
MINERU_FALLBACK_PYPDF=true

# 阿里云百炼 Embedding（OpenAI 兼容协议）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# Milvus（VM 上 docker compose 部署，见 docker-compose.milvus.yml）
MILVUS_URI=http://192.168.178.100:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=insurance_chunks

# ai-service 业务库（与电商库同实例，使用独立 ai_* 表）
AI_MYSQL_URL=mysql+pymysql://root:root@192.168.178.100:3306/qoder_fullstack?charset=utf8mb4

# RAG 参数：递归字符切分与检索门控
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
REFUSAL_MESSAGE=抱歉，我只能回答与该保险文档相关的问题。

# 网关身份头签名校验：开启时必须与网关 jwt.secret 一致
GATEWAY_JWT_SECRET=
VERIFY_GATEWAY_SIGNATURE=false

# LangSmith 链路追踪：留空 LANGSMITH_TRACING=false 即不开启
LANGSMITH_TRACING=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=insurance-agent
