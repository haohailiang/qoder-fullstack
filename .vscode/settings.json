{
  // Red Hat Java 插件的语言服务器需要 JDK 21+ 运行，这里指向本机已安装的 JDK 25
  "java.jdt.ls.java.home": "D:\\Java\\jdk-25",

  // 项目编译/运行所用的 JDK 列表；后端 pom.xml 目标是 Java 17，设为 default
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "D:\\Java\\jdk-17",
      "default": true
    },
    {
      "name": "JavaSE-25",
      "path": "D:\\Java\\jdk-25"
    }
  ],

  // Maven 导入时也使用 JDK 17，保证与 pom.xml 的 java.version 一致
  "maven.terminal.useJavaHome": true,
  "maven.executable.options": "-Dmaven.compiler.release=17",
  "java.compile.nullAnalysis.mode": "automatic",
  "java.autobuild.enabled": true
}
