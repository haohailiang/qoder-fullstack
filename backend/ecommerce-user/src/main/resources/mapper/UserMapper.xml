<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  用户表 SQL 映射（MyBatis XML 方式，不使用注解写 SQL）。
  users 表采用下划线命名（created_by / created_date / last_modified_by / last_modified_date），
  通过下方 resultMap 显式映射为实体 User 的驼峰字段，语义保持不变。
-->
<mapper namespace="com.ecommerce.user.repository.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.ecommerce.user.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="age" column="age"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdDate" column="created_date"/>
        <result property="lastModifiedBy" column="last_modified_by"/>
        <result property="lastModifiedDate" column="last_modified_date"/>
        <result property="themePreference" column="theme_preference"/>
    </resultMap>

    <sql id="BaseColumns">
        id, username, password, name, email, phone, age,
        created_by, created_date, last_modified_by, last_modified_date, theme_preference
    </sql>

    <select id="selectAll" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM users
        ORDER BY id
    </select>

    <select id="selectById" parameterType="long" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM users
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" parameterType="string" resultMap="UserResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM users
        WHERE username = #{username}
        LIMIT 1
    </select>

    <select id="countByUsername" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE username = #{username}
    </select>

    <select id="countById" parameterType="long" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.ecommerce.user.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, password, name, email, phone, age,
                           created_by, created_date, last_modified_by, last_modified_date,
                           theme_preference)
        VALUES (#{username}, #{password}, #{name}, #{email}, #{phone}, #{age},
                #{createdBy}, #{createdDate}, #{lastModifiedBy}, #{lastModifiedDate},
                COALESCE(#{themePreference}, 'dark'))
    </insert>

    <!-- 更新时不覆盖 created_by / created_date，仅刷新 last_modified_by / last_modified_date -->
    <update id="updateById" parameterType="com.ecommerce.user.entity.User">
        UPDATE users
        SET username           = #{username},
            password           = #{password},
            name               = #{name},
            email              = #{email},
            phone              = #{phone},
            age                = #{age},
            last_modified_by   = #{lastModifiedBy},
            last_modified_date = #{lastModifiedDate}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM users WHERE id = #{id}
    </delete>

    <update id="updateThemePreference">
        UPDATE users
        SET theme_preference = #{themePreference}
        WHERE id = #{id}
    </update>

</mapper>
