# --- 构建阶段 ---
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /app
COPY pom.xml .
COPY ecommerce-common/pom.xml ecommerce-common/
COPY ecommerce-user/pom.xml ecommerce-user/
COPY ecommerce-gateway/pom.xml ecommerce-gateway/
COPY ecommerce-product/pom.xml ecommerce-product/
COPY ecommerce-order/pom.xml ecommerce-order/
RUN mvn dependency:go-offline -pl ecommerce-product -am -B

COPY ecommerce-common/ ecommerce-common/
COPY ecommerce-product/ ecommerce-product/
RUN mvn package -pl ecommerce-product -am -DskipTests -B

# --- 运行阶段 ---
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /app/ecommerce-product/target/*.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "app.jar"]
