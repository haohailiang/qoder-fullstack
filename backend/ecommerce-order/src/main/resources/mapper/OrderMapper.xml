<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ecommerce.order.repository.mapper.OrderMapper">

    <resultMap id="OrderResultMap" type="com.ecommerce.order.entity.Order">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="quantity" column="quantity"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status" typeHandler="com.ecommerce.order.entity.enums.OrderStatusTypeHandler"/>
        <result property="address" column="address"/>
        <result property="remark" column="remark"/>
        <result property="createdDate" column="created_date"/>
        <result property="updatedDate" column="updated_date"/>
    </resultMap>

    <sql id="BaseColumns">
        id, order_no, user_id, product_id, product_name, quantity, total_amount,
        status, address, remark, created_date, updated_date
    </sql>

    <select id="selectByUserId" resultMap="OrderResultMap">
        SELECT <include refid="BaseColumns"/> FROM orders WHERE user_id = #{userId} ORDER BY id DESC
    </select>

    <select id="selectById" parameterType="long" resultMap="OrderResultMap">
        SELECT <include refid="BaseColumns"/> FROM orders WHERE id = #{id}
    </select>

    <select id="selectByOrderNo" parameterType="string" resultMap="OrderResultMap">
        SELECT <include refid="BaseColumns"/> FROM orders WHERE order_no = #{orderNo}
    </select>

    <insert id="insert" parameterType="com.ecommerce.order.entity.Order"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO orders (order_no, user_id, product_id, product_name, quantity, total_amount,
                            status, address, remark, created_date, updated_date)
        VALUES (#{orderNo}, #{userId}, #{productId}, #{productName}, #{quantity}, #{totalAmount},
                #{status,typeHandler=com.ecommerce.order.entity.enums.OrderStatusTypeHandler}, #{address}, #{remark}, #{createdDate}, #{updatedDate})
    </insert>

    <update id="updateStatus">
        UPDATE orders SET status = #{status,typeHandler=com.ecommerce.order.entity.enums.OrderStatusTypeHandler}, updated_date = NOW() WHERE id = #{id}
    </update>

    <select id="selectAll" resultMap="OrderResultMap">
        SELECT <include refid="BaseColumns"/> FROM orders ORDER BY id DESC
    </select>
</mapper>
