{
  "name": "qoder-fullstack",
  "private": true,
  "scripts": {
    "test:unit": "npm --prefix frontend/base-app run test && npm --prefix frontend/product-app run test && npm --prefix frontend/order-app run test",
    "test:unit:base": "npm --prefix frontend/base-app run test",
    "test:unit:product": "npm --prefix frontend/product-app run test",
    "test:unit:order": "npm --prefix frontend/order-app run test",
    "test:e2e": "npm --prefix frontend/e2e run test:e2e -- --config=playwright.config.ts",
    "test:e2e:ui": "npm --prefix frontend/e2e run test:e2e:ui -- --config=playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "ssh2": "^1.17.0"
  }
}
